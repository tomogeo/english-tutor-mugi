# Copy this file to .env.local in the same folder and fill in the values.
# The dev server reads .env.local (and .env) with Vite's loadEnv on every request, so a new key needs no restart.
# .env.local is git-ignored: never commit it.
# The keys below are set from Settings on this PC only (a phone sees their status). Settings writes them to this file and
# shows only the last four characters of a key. MUGI_DAILY_USD can also be set from Settings on a phone (through Tailscale).
# Other lines of this file are kept as they are.

# Claude: needed for the chat, the 速查 lookup and the 小提醒 rewrite.
ANTHROPIC_API_KEY=
# Model id. Empty = the default in src/game/claudeProtocol.ts (CLAUDE_MODEL_DEFAULT), which is claude-haiku-5-5.
# Set claude-opus-5-5 here to use Opus 5.5 instead (higher price per token, so MUGI_DAILY_USD buys fewer sentences).
ANTHROPIC_MODEL=
# Optional. Only if your key is scoped to a workspace: sent as the anthropic-workspace-id header.
ANTHROPIC_WORKSPACE_ID=

# Azure AI Speech (cloud voice for English and Chinese). Both are needed to enable it.
AZURE_SPEECH_KEY=
# Region of the Speech resource, for example eastasia or southeastasia.
AZURE_SPEECH_REGION=

# Google Cloud Text-to-Speech API key (cloud voice). Optional.
GOOGLE_TTS_API_KEY=

# Limits and network. MUGI_LAN is read from the process environment when the dev server starts (restart after changing it).
# Set MUGI_LAN in the shell only: a value written in .env.local has no effect on it.
# The two limits below are read from .env.local or the process environment on every request (no restart needed).
# Phone on the same Wi-Fi without Tailscale: 1 = listen on all network interfaces. Default (empty) = this PC only (127.0.0.1).
# Risk: anyone on that network can use your Claude key and speech services through this server. Prefer Tailscale Serve.
# With MUGI_LAN=1 the server prints a pairing code once at start (MUGI_LAN 配對碼：…); a phone that connects by IP enters it once
# (the app keeps it in the browser), and each /api request from an IP address must carry it (X-Mugi-Pair), or it gets 403.
# Names (localhost, Tailscale) never need it. A new code is made each time the server starts.
MUGI_LAN=
# Most chat requests (chat, 小提醒 check and rewrite) started per minute, all together. Default: 20. 0 = no limit.
MUGI_CHAT_PER_MINUTE=
# Estimated Claude spending per day in USD (this PC's local day). Once reached, Claude calls return 429 until midnight.
# Also changeable in Settings (每日預算上限).
# Default: 2. 0 = no cap. The estimate uses the prices in server/usage.ts; the Anthropic Console is the real bill.
MUGI_DAILY_USD=

# Names the dev server accepts besides localhost (comma-separated, e.g. your Tailscale Serve name). Read from the process
# environment when the server starts: set it in the shell that runs npm run dev, not in .env.local.
# MUGI_ALLOWED_HOSTS=
# Folder of the ChatGPT sign-in data. Default: ~/.mugi-tutor. Also read from the process environment, not .env.local.
# MUGI_DATA_DIR=
